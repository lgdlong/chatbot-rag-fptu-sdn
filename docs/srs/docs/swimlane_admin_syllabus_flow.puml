@startuml
title Luồng Admin - Tạo, phê duyệt và kích hoạt syllabus

skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #FFFDF7
  BorderColor #7C2D12
  DiamondBackgroundColor #FDE68A
  DiamondBorderColor #92400E
  FontColor #431407
}

|Admin|
start
:Đăng nhập hệ thống quản trị;
:Mở màn hình Quản lý Syllabus;

|Frontend Admin|
:Tìm Subject Code hiện có;

|Backend API|
:Trả về danh sách các phiên bản syllabus;

if (Đã tồn tại Subject Code?) then (Có)
  |Admin|
  :Chọn tạo phiên bản mới;
else (Không)
  |Admin|
  :Bắt đầu tạo syllabus mới;
endif

|Frontend Admin|
:Nhập metadata môn học;
:Nhập CLOs;
:Nhập lịch học chi tiết;
:Nhập cơ cấu đánh giá;

|Backend API|
:Kiểm tra các trường bắt buộc;
:Tính tổng trọng số đánh giá;

if (Tổng weight = 100%) then (Đúng)
  |Frontend Admin|
  :Cho phép nhập học liệu;
else (Sai)
  |Frontend Admin|
  :Báo lỗi tổng weight không hợp lệ;
  |Admin|
  :Chỉnh sửa cơ cấu đánh giá;
  |Backend API|
  :Kiểm tra lại dữ liệu;
endif

|Frontend Admin|
:Lưu bản nháp;

|Backend API|
:Tạo bản nháp với `is_active = false`;
:Tạo bản nháp với `is_approved = false`;

|Admin|
:Review nội dung và gửi phê duyệt;

|Backend API|
:Ghi AuditLog người duyệt và thời gian;
:Cập nhật `is_approved = true`;
:Cập nhật `is_active = true`;
:Tự động vô hiệu hóa phiên bản cũ cùng Subject Code;

|Frontend Admin|
:Thông báo syllabus đã kích hoạt;

|Sinh viên|
:Có thể tìm thấy syllabus mới trên hệ thống;

stop
@enduml
