@startuml
title Luồng Xác Thực Sinh Viên - Đăng nhập Google OAuth

skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #F0FDF4
  BorderColor #166534
  DiamondBackgroundColor #DCFCE7
  DiamondBorderColor #15803D
  FontColor #14532D
}

|Sinh viên|
start
:Mở trang đăng nhập;
:Nhấn "Đăng nhập bằng Google";

|Google OAuth|
:Hiển thị popup chọn tài khoản;
:Xác thực tài khoản Google;
:Trả về ID token;

|Backend Xác thực|
:Kiểm tra email trong whitelist;

if (Email nằm trong whitelist?) then (Có)
  |Frontend Web|
  :Chuyển hướng đến trang chủ;
else (Không)
  |Frontend Web|
  :Thông báo chưa được cấp quyền;
  |Sinh viên|
  :Liên hệ admin để được thêm quyền;
endif

stop
@enduml
