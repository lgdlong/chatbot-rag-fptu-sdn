@startuml
title Luồng Super Admin - Quản lý tài khoản và phân quyền

skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #EFF6FF
  BorderColor #1E40AF
  DiamondBackgroundColor #BFDBFE
  DiamondBorderColor #2563EB
  FontColor #1E3A8A
}

|Super Admin|
start
:Đăng nhập bằng email và mật khẩu;

|Frontend Super Admin|
:Mở dashboard Super Admin;

if (Chọn chức năng nào?) then (Tài khoản Admin)
  |Frontend Super Admin|
  :Mở danh sách tài khoản Admin;
  |Super Admin|
  :Tạo, xóa hoặc vô hiệu hóa tài khoản;
  |Backend API|
  :Lưu thay đổi tài khoản Admin;
elseif (Whitelist email) then (Whitelist)
  |Frontend Super Admin|
  :Mở danh sách email được phép truy cập;
  |Super Admin|
  :Thêm hoặc xóa email sinh viên;
  |Backend API|
  :Cập nhật whitelist email;
else (Tính năng Admin)
  |Frontend Super Admin|
  :Truy cập toàn bộ tính năng quản trị nội dung;
  |Backend API|
  :Cho phép thao tác như vai trò Admin;
endif

|Frontend Super Admin|
:Thông báo thao tác hoàn tất;

stop
@enduml
