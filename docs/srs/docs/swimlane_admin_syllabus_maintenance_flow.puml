@startuml
title Luồng Admin - Sửa, vô hiệu hóa hoặc xóa syllabus

skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #FFF7ED
  BorderColor #9A3412
  DiamondBackgroundColor #FED7AA
  DiamondBorderColor #C2410C
  FontColor #431407
}

|Admin|
start
:Mở chức năng quản lý syllabus;
:Tìm Subject Code cần xử lý;

|Frontend Admin|
:Hiển thị toàn bộ phiên bản;
:Bao gồm active, inactive,\napproved và unapproved;

|Admin|
:Chọn phiên bản cần thao tác;

if (Hành động nào?) then (Sửa nhỏ)
  |Frontend Admin|
  :Mở form chỉnh sửa nhanh;
  |Admin|
  :Sửa typo hoặc ghi chú;
  |Backend API|
  :Lưu đè trực tiếp vào syllabus;
  |Frontend Admin|
  :Thông báo cập nhật thành công;
elseif (Vô hiệu hóa) then (Ẩn)
  |Backend API|
  :Cập nhật `is_active = false`;
  |Frontend Admin|
  :Ẩn syllabus khỏi phía sinh viên;
else (Xóa hẳn)
  |Frontend Admin|
  :Yêu cầu xác nhận xóa;
  if (Admin xác nhận?) then (Có)
    |Backend API|
    :Xóa vật lý syllabus khỏi cơ sở dữ liệu;
    :Xóa toàn bộ embedding liên quan;
    |Frontend Admin|
    :Thông báo xóa hoàn tất;
  else (Không)
    |Admin|
    :Quay lại danh sách phiên bản;
  endif
endif

stop
@enduml
