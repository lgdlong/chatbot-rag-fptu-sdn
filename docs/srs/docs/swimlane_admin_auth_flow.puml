@startuml
title Luồng Xác Thực Admin - Đăng nhập bằng email và mật khẩu

skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #F9FAFB
  BorderColor #374151
  DiamondBackgroundColor #E5E7EB
  DiamondBorderColor #4B5563
  FontColor #111827
}

|Admin|
start
:Mở trang đăng nhập Admin;
:Nhập email và mật khẩu;

|Frontend Admin|
:Gửi thông tin xác thực;

|Better Auth / Backend|
:Kiểm tra credentials;

if (Thông tin hợp lệ?) then (Có)
  |Frontend Admin|
  :Chuyển hướng đến dashboard;
else (Không)
  |Frontend Admin|
  :Thông báo sai email hoặc mật khẩu;
  |Admin|
  :Chọn thử lại hoặc quên mật khẩu;
  |Better Auth / Backend|
  :Kích hoạt luồng đặt lại mật khẩu nếu được yêu cầu;
endif

stop
@enduml
