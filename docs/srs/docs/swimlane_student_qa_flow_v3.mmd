    class SV1,SV2,SV3,SV4,SV5,SV6,SV7,SV8 sv;
    class FE1,FE2,FE3,FE4,FE5,FE6,FE7,FE8 fe;
    class GG1,GG2,KB1 ext;
    class BEA1,API1,API2,RAG1,RAG2,RAG3,RAG4 be;
    class DEC1,DEC2 decision;
